{
  "name": "marketlaw",
  "private": true,
  "type": "module",
  "scripts": {
    "typegen": "wrangler types",
    "typecheck": "wrangler types && tsc -p tsconfig.client.json && tsc -p tsconfig.server.json",
    "build": "vite build",
    "dev": "vite build && wrangler dev",
    "deploy": "npm run typecheck && vite build && wrangler deploy"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "wrangler": "4.20.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.25.4": true,
    "workerd@1.20250604.0": true
  }
}
