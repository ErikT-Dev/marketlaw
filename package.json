{
  "name": "marketlaw",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typegen": "wrangler types",
    "typecheck": "wrangler types && tsc -p tsconfig.engine.json && tsc -p tsconfig.client.json && tsc -p tsconfig.server.json && tsc -p tsconfig.tools.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "arch": "depcruise src",
    "unused": "knip",
    "dupes": "jscpd",
    "secrets": "secretlint \"**/*\"",
    "test": "vitest run --coverage",
    "harness": "npm run harness:check",
    "harness:check": "node tools/harness-check/checkHarness.ts",
    "size": "vite build && size-limit",
    "check": "npm run typecheck && npm run lint && npm run arch && npm run unused && npm run dupes && npm run secrets && npm run test && npm run harness && npm run size",
    "e2e": "playwright test --pass-with-no-tests",
    "build": "vite build",
    "dev": "vite build && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply marketlaw --local",
    "db:migrate:remote": "wrangler d1 migrations apply marketlaw --remote",
    "deploy": "npm run check && npm run db:migrate:remote && wrangler deploy",
    "design:export": "node tools/design-export/exportDesign.ts",
    "design:images": "node tools/design-export/receiveBoardImages.ts"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@size-limit/file": "14.2.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "1.6.27",
    "ajv": "8.17.1",
    "dependency-cruiser": "18.6.0",
    "eslint": "9.39.5",
    "eslint-plugin-functional": "10.0.1",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-testing-library": "7.16.2",
    "jscpd": "5.4.1",
    "jsdom": "30.1.2",
    "knip": "6.41.0",
    "prettier": "3.9.10",
    "secretlint": "13.0.7",
    "size-limit": "14.2.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.2",
    "vite": "6.3.5",
    "vitest": "4.1.11",
    "wrangler": "4.20.0",
    "yaml": "2.8.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.25.4": true,
    "esbuild@0.28.2": true,
    "workerd@1.20250604.0": true,
    "workerd@1.20261006.1": true
  }
}
