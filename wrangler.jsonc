{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marketlaw",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist/client"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "GameRoom" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CounterRoom"] },
    { "tag": "v2", "deleted_classes": ["CounterRoom"] },
    { "tag": "v3", "new_sqlite_classes": ["GameRoom"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "marketlaw",
      "database_id": "653e1029-fa40-4d41-b786-aa74d6078761",
      "migrations_dir": "migrations"
    }
  ]
}
