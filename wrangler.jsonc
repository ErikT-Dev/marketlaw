{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marketlaw",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFx3FNRK4PPfX9CB",
    "PRIVACY_CONTACT": "PLACEHOLDER: the owner has not given the contact address yet"
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "assets": {
    "directory": "./dist/client"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "GameRoom" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CounterRoom"] },
    { "tag": "v2", "deleted_classes": ["CounterRoom"] },
    { "tag": "v3", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v4", "new_sqlite_classes": ["Lobby"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "marketlaw",
      "database_id": "653e1029-fa40-4d41-b786-aa74d6078761",
      "migrations_dir": "migrations"
    }
  ]
}
