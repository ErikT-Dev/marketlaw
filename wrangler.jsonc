{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marketlaw",
  "main": "src/server/worker.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist/client"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "CounterRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CounterRoom"] }]
}
